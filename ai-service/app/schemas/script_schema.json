{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["script"],
  "properties": {
    "script": {
      "type": "object",
      "required": ["metadata", "characters", "scenes"],
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["title", "source_title", "adaptation_mode"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "source_title": {"type": "string", "minLength": 1},
            "adaptation_mode": {"type": "string", "enum": ["screen_script", "stage_play", "short_video", "radio_drama"]},
            "language": {"type": "string", "default": "zh-CN"},
            "version": {"type": "integer", "minimum": 1}
          }
        },
        "characters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "role", "description", "personality", "source_trace"],
            "properties": {
              "id": {"type": "string", "pattern": "^char_\\d{3}$"},
              "name": {"type": "string", "minLength": 1},
              "aliases": {"type": "array", "items": {"type": "string"}},
              "role": {"type": "string", "enum": ["protagonist", "antagonist", "supporting", "minor"]},
              "description": {"type": "string"},
              "personality": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "relationships": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["target", "relation"],
                  "properties": {
                    "target": {"type": "string"},
                    "relation": {"type": "string"}
                  }
                }
              },
              "source_trace": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["chapter_index", "paragraph_start", "paragraph_end"],
                  "properties": {
                    "chapter_index": {"type": "integer", "minimum": 1},
                    "paragraph_start": {"type": "integer", "minimum": 1},
                    "paragraph_end": {"type": "integer", "minimum": 1}
                  }
                }
              }
            }
          }
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "order", "time", "location", "source_trace", "characters", "summary"],
            "properties": {
              "id": {"type": "string", "pattern": "^scene_\\d{3}$"},
              "title": {"type": "string", "minLength": 1},
              "order": {"type": "integer", "minimum": 1},
              "time": {"type": "string"},
              "location": {"type": "string"},
              "source_trace": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["chapter_index", "paragraph_start", "paragraph_end"],
                  "properties": {
                    "chapter_index": {"type": "integer", "minimum": 1},
                    "paragraph_start": {"type": "integer", "minimum": 1},
                    "paragraph_end": {"type": "integer", "minimum": 1}
                  }
                }
              },
              "characters": {"type": "array", "items": {"type": "string"}},
              "summary": {"type": "string"},
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "character": {"type": "string"},
                    "description": {"type": "string"}
                  }
                }
              },
              "dialogues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["character", "line"],
                  "properties": {
                    "character": {"type": "string"},
                    "line": {"type": "string"},
                    "emotion": {"type": "string"}
                  }
                }
              },
              "adaptation_notes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source": {"type": "string"},
                    "change": {"type": "string"},
                    "reason": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "adaptation_summary": {
          "type": "object",
          "properties": {
            "total_chapters": {"type": "integer"},
            "total_scenes": {"type": "integer"},
            "main_conflict": {"type": "string"},
            "hallucination_risk": {"type": "string", "enum": ["low", "medium", "high"]}
          }
        }
      }
    }
  }
}
