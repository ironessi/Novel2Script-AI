# Novel2Script-AI 环境变量配置
# 复制此文件为 .env 并修改配置
# ⚠️ 不要将 .env 提交到 Git

# 应用环境
APP_ENV=local
APP_PORT=8000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=novel2script
MYSQL_USER=root
MYSQL_PASSWORD=lhm20060623

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# AI Service
AI_SERVICE_URL=http://localhost:9000
AI_SERVICE_TOKEN=change_me_internal_token

# LLM
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# 文件上传
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_EXTENSIONS=.txt,.md,.docx
STORAGE_PATH=./storage
